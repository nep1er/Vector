<UserControl x:Class="Vector.Desktop.Controls.ProfileView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" FontSize="16" Foreground="{DynamicResource Brush.Text}">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Brush.Input}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,6,0,8"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource Brush.Input}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,6,0,8"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/><Setter Property="Padding" Value="14,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
  <StackPanel HorizontalAlignment="Center" Margin="0,8,0,28">
   <Button Width="112" Height="112" Click="Upload_Click" ToolTip="Изменить фото профиля" AutomationProperties.Name="Изменить фото профиля" HorizontalAlignment="Center">
    <Button.Template><ControlTemplate TargetType="Button"><Grid><ContentPresenter/><Border x:Name="Shade" Background="#8C140A00" CornerRadius="56" Opacity="0" IsHitTestVisible="False"><Viewbox Width="26" Height="26"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.75" Data="M3,7 H7 L9,4 H15 L17,7 H21 V20 H3 Z"/><Ellipse Canvas.Left="8" Canvas.Top="9" Width="8" Height="8" Stroke="White" StrokeThickness="1.75"/></Canvas></Viewbox></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
    <Border x:Name="Avatar" Width="112" Height="112" CornerRadius="56" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"><TextBlock x:Name="Initial" FontSize="44" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Button>
   <TextBlock x:Name="HeroName" FontSize="20" FontWeight="SemiBold" Margin="0,10" HorizontalAlignment="Center"/>
   <Button Content="Удалить фото" Click="RemoveAvatar_Click" Margin="0,6,0,0" HorizontalAlignment="Center"/>
  </StackPanel>
  <TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
  <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8">
   <StackPanel x:Name="Form">
    <Border Padding="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
     <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Изменить" Click="Toggle_Click" Tag="username"/><StackPanel><TextBlock Text="Имя пользователя" FontWeight="SemiBold"/><TextBlock x:Name="NameValue" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel></DockPanel>
      <StackPanel x:Name="NameForm" Visibility="Collapsed" Margin="0,10,0,0"><TextBox x:Name="NameInput" MaxLength="50"/><Button Content="Сохранить" Click="SaveName_Click" HorizontalAlignment="Right" Background="{DynamicResource Brush.Accent}" Foreground="White"/></StackPanel>
     </StackPanel>
    </Border>
    <Border Padding="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
     <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Изменить" Click="Toggle_Click" Tag="email"/><StackPanel><TextBlock Text="Email" FontWeight="SemiBold"/><TextBlock x:Name="EmailValue" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel></DockPanel>
      <StackPanel x:Name="EmailForm" Visibility="Collapsed" Margin="0,10,0,0"><TextBox x:Name="EmailInput"/><Button Content="Сохранить" Click="SaveEmail_Click" HorizontalAlignment="Right" Background="{DynamicResource Brush.Accent}" Foreground="White"/></StackPanel>
     </StackPanel>
    </Border>
    <Border Padding="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
     <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Изменить" Click="Toggle_Click" Tag="password"/><StackPanel><TextBlock Text="Пароль" FontWeight="SemiBold"/><TextBlock Text="••••••••" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel></DockPanel>
      <StackPanel x:Name="PasswordForm" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="Текущий пароль"/><PasswordBox x:Name="OldPassword"/><TextBlock Text="Новый пароль"/><PasswordBox x:Name="NewPassword"/><TextBlock Text="Повторите новый пароль"/><PasswordBox x:Name="RepeatPassword"/><Button Content="Изменить пароль" Click="SavePassword_Click" HorizontalAlignment="Right" Background="{DynamicResource Brush.Accent}" Foreground="White"/></StackPanel>
     </StackPanel>
    </Border>
    <Border Padding="16"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Удалить" Click="Toggle_Click" Tag="delete" Foreground="{DynamicResource Brush.Danger}"/><TextBlock Text="Удалить аккаунт" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><StackPanel x:Name="DeleteForm" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="Введите «удалить» для подтверждения"/><TextBox x:Name="DeleteInput"/><Button Content="Удалить навсегда" Click="Delete_Click" HorizontalAlignment="Right" Background="{DynamicResource Brush.Danger}" Foreground="White"/></StackPanel></StackPanel></Border>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>