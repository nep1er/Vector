<Window x:Class="Vector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,24">
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brush.Accent}">
                            <TextBlock Text="V" Foreground="White" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Vector" Margin="10,0,0,0"
                                   Foreground="{StaticResource Brush.SidebarText}" FontSize="21"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="12,0,12,16">
                    <Button Style="{StaticResource NavigationButton}" Tag="Проекты" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="28" FontSize="17" />
                            <TextBlock Text="Проекты" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="Задачи" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☷" Width="28" FontSize="17" />
                            <TextBlock Text="Задачи" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="Друзья" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♧" Width="28" FontSize="17" />
                            <TextBlock Text="Друзья" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="Расширения" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" Width="28" FontSize="17" />
                            <TextBlock Text="Расширения" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Tag="Уведомления" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♧" Width="28" FontSize="17" />
                            <TextBlock Text="Уведомления" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#54402A" BorderThickness="0,1,0,0"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Профиль" Foreground="{StaticResource Brush.SidebarText}" FontWeight="SemiBold" />
                        <TextBlock Text="Настройки и аккаунт" Foreground="{StaticResource Brush.SidebarMuted}"
                                   FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="Проекты" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text}" />
                <TextBlock x:Name="PageDescription" Text="Рабочее пространство Vector"
                           FontSize="14" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,28,0,0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8"
                    Padding="28">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Основа Desktop-клиента готова к развитию"
                               FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="На следующих этапах сюда будут перенесены реальные экраны и сценарии Web-версии."
                               TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
