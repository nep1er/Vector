<Window x:Class="Vector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SideNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.SidebarMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="ActiveMark" Width="3" HorizontalAlignment="Left"
                                        Background="{StaticResource Brush.AccentHover}" CornerRadius="0,2,2,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SidebarHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SidebarActive}"/>
                                <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: размеры и интервалы повторяют Layout/Sidebar Web-клиента. -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="22,20,22,22">
                    <Image Source="/Vector.Desktop;component/Resources/Brand/logo.png"
                           Height="32" Stretch="Uniform" HorizontalAlignment="Left"/>
                </Border>

                <StackPanel Margin="12,0,12,16">
                    <Button Style="{StaticResource SideNavButton}" Tag="Active" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▱" FontSize="19" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Проекты" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" Tag="Задачи">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☷" FontSize="18" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Задачи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" Tag="Друзья">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♧" FontSize="19" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Друзья" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" Tag="Расширения">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" FontSize="19" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Расширения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" Tag="Уведомления">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="♧" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Уведомления" VerticalAlignment="Center"/>
                            <Border x:Name="UnreadBadge" Grid.Column="2" Background="{StaticResource Brush.Accent}"
                                    CornerRadius="10" Padding="6,1" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadCount" Text="0" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,0,12,0" Padding="0,12,0,0"
                        BorderBrush="{StaticResource Brush.SidebarBorder}" BorderThickness="0,1,0,0">
                    <Button x:Name="ProfileButton" Click="ProfileButton_Click" Background="Transparent"
                            BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch"
                            Foreground="{StaticResource Brush.SidebarText}" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileAvatar" Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource Brush.Accent}" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileInitial" Text="?" Foreground="White"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" Text="Профиль" FontSize="13"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProfileEmail" Text="Настройки и аккаунт" FontSize="11"
                                           Foreground="{StaticResource Brush.SidebarMuted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>
            </DockPanel>
        </Border>

        <!-- Основная область: max-width 1040, padding 40 px, как .main-inner. -->
        <Grid Grid.Column="1" Background="{StaticResource Brush.Background}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid HorizontalAlignment="Center" MaxWidth="1040" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="40,40,40,64">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Проекты" FontSize="32" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}" LineHeight="40"/>
                                    <TextBlock x:Name="ProjectsSummary" Text="" Margin="0,4,0,0"
                                               FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
                                </StackPanel>
                                <TextBox x:Name="ProjectSearch" Grid.Column="1" Style="{StaticResource SearchBox}"
                                         Margin="20,0,16,0" VerticalAlignment="Center"
                                         TextChanged="ProjectSearch_TextChanged"
                                         ToolTip="Найти проект"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" Click="CreateProjectButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="20" Margin="0,-2,8,0"/>
                                        <TextBlock Text="Создать проект"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="StatusMessage" Text="Загрузка проектов…"
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="14"
                                       Margin="0,0,0,16" Visibility="Collapsed"/>

                            <ItemsControl x:Name="ProjectsItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,24,24" Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                                                CornerRadius="8" MinHeight="260" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="150"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{Binding CoverBrush}">
                                                    <Grid>
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                        <TextBlock Text="{Binding Initial}" FontSize="64" FontWeight="ExtraBold"
                                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Avatar}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Text}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="14" Margin="0,6,0,0"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               TextWrapping="Wrap" MaxHeight="40"/>
                                                    <TextBlock Text="{Binding CreatedLabel}" FontSize="12" Margin="0,8,0,0"
                                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="EmptyState" Padding="24,72" BorderBrush="{StaticResource Brush.BorderStrong}"
                                    BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="▱" FontSize="32" Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Проектов пока нет" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Диалог создания проекта, повторяющий смысл и компоновку Web-модального окна. -->
        <Grid x:Name="CreateOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="460" Padding="28,20,28,24" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="Новый проект" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}"/>
                        <Button Content="×" DockPanel.Dock="Right" Click="CloseCreateProject_Click"
                                Background="Transparent" BorderThickness="0" FontSize="22"
                                Foreground="{StaticResource Brush.TextMuted}" Width="32"/>
                    </DockPanel>
                    <TextBlock Text="Название" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NewProjectTitle" Height="38" Padding="12,8" MaxLength="150"
                             Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.BorderStrong}"
                             Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="Описание (необязательно)" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,16,0,6"/>
                    <TextBox x:Name="NewProjectDescription" Height="92" Padding="12,8" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.BorderStrong}"
                             Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock x:Name="CreateError" Foreground="{StaticResource Brush.Danger}"
                               FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Отмена" Padding="14,8" Margin="0,0,10,0"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.BorderStrong}"
                                Foreground="{StaticResource Brush.Text}" Click="CloseCreateProject_Click"/>
                        <Button x:Name="SubmitCreateProject" Content="Создать проект" Style="{StaticResource PrimaryButton}"
                                Click="SubmitCreateProject_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>