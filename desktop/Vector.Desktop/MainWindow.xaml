<Window x:Class="Vector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vector.Desktop.Controls"
        Title="Vector" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Background}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SideNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="ActiveMark" Width="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.AccentHover}" CornerRadius="0,2,2,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarActive}"/>
                                <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="UserMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MenuBg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuBg" Property="Background" Value="{DynamicResource Brush.SidebarHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.SidebarMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="6,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ThemeBg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness=".5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="Tag" Value="Active"><Setter TargetName="ThemeBg" Property="Background" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: размеры и интервалы повторяют Layout/Sidebar Web-клиента. -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="22,20,22,18">
                    <Image Source="/Vector.Desktop;component/Resources/Brand/logo.png"
                           Height="32" Stretch="Uniform" HorizontalAlignment="Left"/>
                </Border>

                <!-- Профиль должен быть отдельным нижним элементом DockPanel.
                     Последний элемент DockPanel заполняет остаток высоты, поэтому
                     навигация располагается последней и занимает центральную область. -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" Padding="0,12,0,0"
                        BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="0,1,0,0">
                    <Button x:Name="ProfileButton" Click="ProfileButton_Click" Background="Transparent"
                            BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch"
                            Foreground="{DynamicResource Brush.SidebarText}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ProfileButtonBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ProfileButtonBorder" Property="Background"
                                                Value="{DynamicResource Brush.SidebarHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileAvatar" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <TextBlock x:Name="ProfileInitial" Text="?" Foreground="White"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" Text="Профиль" FontSize="16"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProfileEmail" Text="Настройки и аккаунт" FontSize="14"
                                           Foreground="{DynamicResource Brush.SidebarMuted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>

                <StackPanel x:Name="NavigationPanel" Margin="12,0,12,16">
                    <Button Style="{StaticResource SideNavButton}" Tag="Active" CommandParameter="Проекты" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Data="M3,6 L3,19 L21,19 L21,8 L12,8 L10,6 Z M3,9 L21,9"/>
                            <TextBlock Text="Проекты" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" CommandParameter="Задачи">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Data="M5,5 L7,5 M10,5 L19,5 M5,12 L7,12 M10,12 L19,12 M5,19 L7,19 M10,19 L19,19"/>
                            <TextBlock Text="Задачи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" CommandParameter="Друзья">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Data="M12,11 A4,4 0 1 0 12,3 A4,4 0 1 0 12,11 M4,21 C4,16 8,14 12,14 C16,14 20,16 20,21"/>
                            <TextBlock Text="Друзья" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" CommandParameter="Расширения">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Data="M8,3 L16,3 L16,8 L21,8 L21,16 L16,16 L16,21 L8,21 L8,16 L3,16 L3,8 L8,8 Z"/>
                            <TextBlock Text="Расширения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButton}" Click="NavigationButton_Click" CommandParameter="Уведомления">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.6" Data="M18,9 C18,5 15,3 12,3 C9,3 6,5 6,9 C6,15 4,16 4,18 L20,18 C20,16 18,15 18,9 M10,21 L14,21"/>
                            <TextBlock Grid.Column="1" Text="Уведомления" VerticalAlignment="Center"/>
                            <Border x:Name="UnreadBadge" Grid.Column="2" Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="999" MinWidth="20" Padding="6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadCount" Text="0" Foreground="White" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Широкая страница проектов: отступы 48 px, как .wide-page в Web. -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.Background}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid HorizontalAlignment="Stretch" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="48,40,48,64">
                        <StackPanel>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PageTitle" Text="Проекты" FontSize="32" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" LineHeight="40"/>
                                    <TextBlock x:Name="ProjectsSummary" Text="" Margin="0,4,0,0"
                                               FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                                    <TextBox x:Name="ProjectSearch" Style="{StaticResource SearchBox}"
                                             TextChanged="ProjectSearch_TextChanged" Visibility="Collapsed"/>
                                    <TextBlock Text="Найти проект" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"
                                               x:Name="SearchPlaceholder" Visibility="Collapsed"/>
                                </Grid>
                                <Button x:Name="CreateProjectButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" Click="CreateProjectButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="20" Margin="0,-2,8,0"/>
                                        <TextBlock Text="Создать проект"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="StatusMessage" Text="Загрузка проектов…"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="14"
                                       Margin="0,0,0,16" Visibility="Collapsed"/>

                            <ContentControl x:Name="SectionContent" Visibility="Collapsed"/>
                            <ItemsControl x:Name="ProjectsItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ProjectTilePanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                                CornerRadius="8" MinHeight="260" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="150"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{Binding CoverBrush}">
                                                    <Grid ClipToBounds="True">
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                        <TextBlock Text="{Binding Initial}" FontSize="64" FontWeight="ExtraBold"
                                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Avatar}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="14" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               TextWrapping="Wrap" MaxHeight="40"/>
                                                    <TextBlock Text="{Binding CreatedLabel}" FontSize="12" Margin="0,8,0,0"
                                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="EmptyState" Padding="24,72" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="▱" FontSize="32" Foreground="{DynamicResource Brush.TextMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Проектов пока нет" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Popup x:Name="UserPopup" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Top" VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="240" Padding="6" CornerRadius="8" Background="{DynamicResource Brush.SidebarMenu}" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="MenuEmail" Foreground="{DynamicResource Brush.SidebarMuted}" FontSize="14" Margin="10,8,10,10" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource UserMenuButton}" Click="OpenProfile_Click" Content="♙   Настройки профиля"/>
                    <StackPanel Margin="10,8">
                        <TextBlock Text="◐   Тема" Foreground="{DynamicResource Brush.SidebarText}" FontSize="16" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" ClipToBounds="True">
                            <UniformGrid x:Name="ThemeButtons" Columns="2">
                                <Button Style="{StaticResource ThemeChoice}" CommandParameter="system-light" Click="Theme_Click"><TextBlock Text="Системная светлая" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button Style="{StaticResource ThemeChoice}" CommandParameter="system-dark" Click="Theme_Click"><TextBlock Text="Системная тёмная" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button Style="{StaticResource ThemeChoice}" CommandParameter="light" Click="Theme_Click" Content="Светлая"/>
                                <Button Style="{StaticResource ThemeChoice}" CommandParameter="dark" Click="Theme_Click" Content="Тёмная"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource UserMenuButton}" IsEnabled="False" Content="◎   Язык              Скоро"/>
                    <Button Style="{StaticResource UserMenuButton}" IsEnabled="False" Content="⊙   Помощь         Скоро"/>
                    <Border Height="1" Background="{DynamicResource Brush.SidebarBorder}" Margin="4,6"/>
                    <Button Style="{StaticResource UserMenuButton}" Click="Logout_Click" Content="⇥   Выйти"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Диалог создания проекта, повторяющий смысл и компоновку Web-модального окна. -->
        <Grid x:Name="CreateOverlay" Grid.ColumnSpan="2" Background="#99000000"
              Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="460" Padding="28,20,28,24" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="Новый проект" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <Button Content="×" DockPanel.Dock="Right" Click="CloseCreateProject_Click"
                                Background="Transparent" BorderThickness="0" FontSize="22"
                                Foreground="{DynamicResource Brush.TextMuted}" Width="32"/>
                    </DockPanel>
                    <TextBlock Text="Название" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NewProjectTitle" Height="38" Padding="12,8" MaxLength="150"
                             Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                             Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="Описание (необязательно)" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,16,0,6"/>
                    <TextBox x:Name="NewProjectDescription" Height="92" Padding="12,8" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                             Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock x:Name="CreateError" Foreground="{DynamicResource Brush.Danger}"
                               FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Отмена" Padding="14,8" Margin="0,0,10,0"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                Foreground="{DynamicResource Brush.Text}" Click="CloseCreateProject_Click"/>
                        <Button x:Name="SubmitCreateProject" Content="Создать проект" Style="{StaticResource PrimaryButton}"
                                Click="SubmitCreateProject_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>