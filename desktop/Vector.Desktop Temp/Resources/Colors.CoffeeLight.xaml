<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Values are ported from resources/design/tokens.css. Keep names aligned with the Web tokens. -->
    <Color x:Key="Color.Background">#D3B06C</Color>
    <Color x:Key="Color.Surface">#EFDFB5</Color>
    <Color x:Key="Color.Surface2">#E6D09A</Color>
    <Color x:Key="Color.Hover">#C8A25C</Color>
    <Color x:Key="Color.Border">#B08A48</Color>
    <Color x:Key="Color.BorderStrong">#8C6B32</Color>
    <Color x:Key="Color.Text">#261A0C</Color>
    <Color x:Key="Color.TextMuted">#4D391D</Color>
    <Color x:Key="Color.Accent">#9B1C1C</Color>
    <Color x:Key="Color.AccentHover">#B32424</Color>
    <Color x:Key="Color.Sidebar">#2A1D0F</Color>
    <Color x:Key="Color.SidebarHover">#4D3822</Color>
    <Color x:Key="Color.SidebarActive">#5A4228</Color>
    <Color x:Key="Color.SidebarText">#F3E8D0</Color>
    <Color x:Key="Color.SidebarMuted">#C9B690</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.SidebarActive" Color="{StaticResource Color.SidebarActive}" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource Color.SidebarText}" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}" />

    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.SidebarText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.SidebarHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.SidebarActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
